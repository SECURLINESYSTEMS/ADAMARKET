{
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/how-it-works.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/download.html",
      "destination": "/",
      "permanent": false
